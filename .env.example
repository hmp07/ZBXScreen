# =====================================================================
# ZBXScreen 环境变量配置
# 复制为 .env 并修改: cp .env.example .env
# =====================================================================

# === 必填 (生产环境务必修改) ===
APP_SECRET_KEY=change-this-to-a-random-64-char-string

# === 系统设置 ===
TZ=Asia/Shanghai
DEBUG=false
DEFAULT_ADMIN_PASSWORD=Admin@123

# === 刷新与检测间隔 (秒) ===
DEFAULT_REFRESH_INTERVAL=30
ALERT_CHECK_INTERVAL=60
DATA_RETENTION_DAYS=30

# === Zabbix 连接超时 (秒) ===
ZABBIX_REQUEST_TIMEOUT=25
AGGREGATION_TOTAL_TIMEOUT=28
WEBHOOK_REQUEST_TIMEOUT=10

# === 服务端口 ===
ZBX_PORT=8088
